#!/usr/bin/env python3
"""
mach1-control.py
---------------------------------
MACH1 DIG LCD driver (Linux)

Um driver em espaço de usuário para gerenciar o display digital de temperatura 
e consumo (Watts) dos coolers MACH1 DIG (controladores Semico).

RECURSOS:
  - Exibe a temperatura da CPU (°C / °F) no painel superior.
  - Exibe o consumo de energia em Watts (W) da CPU no painel inferior.
  - Exibe o indicador de barra LED de nivel de uso/temperatura.
  - Detecta automaticamente a interface HID funcional.
  - Seleção inteligente e automática de sensores de CPU no Linux.
  - Inclui comando para instalar regras de udev (acesso sem sudo).
  - Inclui comando para gerar e instalar serviço systemd.
"""

import argparse
import glob
import os
import signal
import sys
import textwrap
import time
from types import FrameType
from typing import List, Dict, Any, Optional, Tuple

# Suporte flexível a bibliotecas HID (python3-hid, python3-hidapi, ou pip hid/hidapi)
try:
    import hid
except ImportError:
    try:
        import hidapi as hid
    except ImportError:
        print("Erro: Nenhuma biblioteca HID encontrada. Instale com 'sudo apt install python3-hid' ou 'pip install hidapi'")
        sys.exit(1)

import psutil

# --- Configurações do Dispositivo ---
VID = 0x1A2C
PIDS = [0x4D84, 0x4C84]  # Possíveis PIDs para MACH1 DIG
REPORT_ID = 0x07
REPORT_LENGTH = 65
DEFAULT_SENSOR_SUBSTR = "auto"
DEFAULT_REFRESH_RATE = 1.0  # segundos
KEEPALIVE_INTERVAL = 2.0  # segundos
UNIT_FLAG_CELSIUS = 0x00
UNIT_FLAG_FAHRENHEIT = 0x01

# Lista de fallbacks comuns para sensores de CPU no Linux
CPU_SENSOR_FALLBACKS = [
    "k10temp", "coretemp", "zenpower", "cpu_thermal",
    "cpu-thermal", "tctl", "tccd1", "package id 0", "soc_thermal"
]


class PowerReader:
    """Lê ou estima o consumo de energia da CPU em Watts no Linux."""
    
    def __init__(self):
        self.rapl_file: Optional[str] = None
        self.last_energy: Optional[int] = None
        self.last_time: Optional[float] = None
        
        # Procurar por arquivos RAPL de energia do Linux
        candidates = glob.glob("/sys/class/powercap/intel-rapl*/energy_uj")
        for fpath in candidates:
            try:
                with open(fpath, "r") as f:
                    val = f.read().strip()
                    if val.isdigit():
                        self.rapl_file = fpath
                        break
            except Exception:
                continue

    def get_watts(self) -> float:
        now = time.time()
        if self.rapl_file:
            try:
                with open(self.rapl_file, "r") as f:
                    energy = int(f.read().strip())
                if self.last_energy is not None and self.last_time is not None:
                    dt = now - self.last_time
                    if dt > 0:
                        de = energy - self.last_energy
                        # Tratar estouro de contador 32-bit (microjoules wrap a cada ~70 min)
                        if de < 0:
                            de += 4_294_967_296
                        if de >= 0:
                            watts = (de / 1_000_000.0) / dt
                            self.last_energy = energy
                            self.last_time = now
                            return max(1.0, min(999.0, watts))
                self.last_energy = energy
                self.last_time = now
            except Exception:
                pass
                
        # Fallback se RAPL não puder ser lido (ex: permissões não-root)
        cpu_pct = psutil.cpu_percent(interval=None)
        # Estimativa aproximada de consumo de CPU (15W idle a ~120W max)
        estimated_watts = 15.0 + (cpu_pct / 100.0) * 105.0
        return estimated_watts


class FanReader:
    """Lê ou estima a velocidade do cooler/ventoinha (RPM) no Linux."""

    def __init__(self):
        pass

    def get_rpm(self) -> float:
        # 1. Tentar psutil.sensors_fans()
        try:
            if hasattr(psutil, "sensors_fans"):
                fans = psutil.sensors_fans()
                for fan_name, fan_list in fans.items():
                    for fan in fan_list:
                        if hasattr(fan, 'current') and fan.current > 0:
                            return float(fan.current)
        except Exception:
            pass

        # 2. Tentar leitura sysfs hwmon diretamente
        try:
            fan_inputs = glob.glob("/sys/class/hwmon/hwmon*/fan*_input")
            for fpath in fan_inputs:
                try:
                    with open(fpath, "r") as f:
                        val = f.read().strip()
                        if val.isdigit() and int(val) > 0:
                            return float(val)
                except Exception:
                    continue
        except Exception:
            pass

        # Fallback estimado baseado na carga da CPU (800 a 2200 RPM)
        cpu_pct = psutil.cpu_percent(interval=None)
        estimated_rpm = 800.0 + (cpu_pct / 100.0) * 1400.0
        return estimated_rpm


class Mach1Controller:
    """Gerencia o dispositivo LCD MACH1 DIG."""

    def __init__(self):
        self.device: Optional[Any] = None
        self.interface_number: Optional[int] = None
        self.active_pid: Optional[int] = None
        self.power_reader = PowerReader()
        self.fan_reader = FanReader()

    def __enter__(self):
        self.open()
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        self.close()

    def open(self) -> bool:
        """Abre a primeira interface funcional do cooler MACH1."""
        if self.device:
            self.close()

        # Tentar desativar USB autosuspend diretamente via sysfs se houver permissão
        for dev_sys in glob.glob("/sys/bus/usb/devices/*/idVendor"):
            try:
                with open(dev_sys, "r") as f:
                    if f.read().strip().lower() == "1a2c":
                        pdir = os.path.dirname(dev_sys)
                        ctrl_file = os.path.join(pdir, "power", "control")
                        if os.path.exists(ctrl_file):
                            with open(ctrl_file, "w") as cf:
                                cf.write("on")
            except Exception:
                pass

        devices = []
        for pid in PIDS:
            devices.extend(hid.enumerate(VID, pid))
            
        if not devices:
            print("Nenhum cooler MACH1 DIG encontrado.")
            return False

        # Ordenar para tentar a interface 1 primeiro (interface do display LCD)
        devices.sort(key=lambda d: 0 if d.get('interface_number') == 1 else 1)

        for device_info in devices:
            interface_number = device_info.get('interface_number')
            if interface_number is None:
                continue

            try:
                device = hid.device()
                device.open_path(device_info['path'])
                
                # Teste para verificar se podemos enviar um relatório
                test_report = [REPORT_ID] + [0] * (REPORT_LENGTH - 1)
                res = device.send_feature_report(test_report)
                if res < 0:
                    # Tenta fallback write
                    try:
                        res = device.write(test_report)
                    except Exception:
                        res = -1
                if res < 0:
                    try:
                        device.close()
                    except Exception:
                        pass
                    continue
                
                self.device = device
                self.interface_number = interface_number
                self.active_pid = device_info['product_id']
                print(f"Conectado ao cooler MACH1 (PID: {hex(self.active_pid)}) na interface {interface_number}")
                return True
            except Exception:
                try:
                    device.close()
                except Exception:
                    pass
                continue

        print("Erro: Nenhuma interface MACH1 funcional encontrada. Verifique permissões (udev).")
        return False

    def close(self):
        """Fecha a conexão com o dispositivo."""
        if self.device:
            try:
                self.device.close()
            except Exception as e:
                print(f"Erro ao fechar o dispositivo: {e}")
            finally:
                self.device = None
                self.interface_number = None

    def send_display_data(self, 
                          temp_celsius: float, 
                          watts: float = 0.0, 
                          unit: str = 'c', 
                          bar_level: Optional[int] = None,
                          mode: str = 'power',
                          lower_value: Optional[float] = None) -> bool:
        """
        Envia os dados completos de Temperatura (°C/°F), Consumo (Watts) ou Rotação do Cooler (RPM) e Barra LED para o display.
        
        Protocolo MACH1 DIG (Report ID 0x07):
          report[0] = 0x07 (REPORT_ID)
          report[1] = dígito de centenas da temperatura
          report[2] = dígito de dezenas da temperatura
          report[3] = dígito de unidades da temperatura
          report[4] = (bar_level << 4) | unit_flag (0=°C, 1=°F)
          report[5] = dígito de centenas do valor inferior (Watts/RPM)
          report[6] = dígito de dezenas do valor inferior
          report[7] = dígito de unidades do valor inferior
        """
        if not self.device:
            print("Dispositivo não conectado.")
            return False

        if lower_value is None:
            if mode.lower() == 'fan':
                rpm = self.fan_reader.get_rpm()
                # Para exibir no painel de 3 dígitos: se RPM > 999, exibe RPM / 10 (ex: 150 = 1500 RPM)
                lower_value = (rpm / 10.0) if rpm > 999 else rpm
            else:
                lower_value = watts

        # Converte a temperatura com base na unidade
        if unit.lower() == 'f':
            display_temp = temp_celsius * 9/5 + 32
            unit_flag = UNIT_FLAG_FAHRENHEIT
        else:
            display_temp = temp_celsius
            unit_flag = UNIT_FLAG_CELSIUS

        # Limita para os intervalos exibíveis (0-999)
        display_temp = max(0, min(999, int(round(display_temp))))
        display_lower = max(0, min(999, int(round(lower_value))))

        if bar_level is None:
            # Calcula o nível de barras (0 a 10) baseado na temperatura da CPU
            bar_level = max(0, min(10, int(temp_celsius // 10)))
        else:
            bar_level = max(0, min(10, bar_level))

        # Dígitos de temperatura
        temp_hundreds = (display_temp // 100) % 10
        temp_tens = (display_temp // 10) % 10
        temp_ones = display_temp % 10

        # Dígitos inferiores (Watts ou RPM)
        lower_hundreds = (display_lower // 100) % 10
        lower_tens = (display_lower // 10) % 10
        lower_ones = display_lower % 10

        # Flag combinada de barras LED e unidade (°C / °F)
        combined_unit_bar = (bar_level << 4) | unit_flag

        report = [REPORT_ID] + [0] * (REPORT_LENGTH - 1)
        report[1] = temp_hundreds
        report[2] = temp_tens
        report[3] = temp_ones
        report[4] = combined_unit_bar
        report[5] = lower_hundreds
        report[6] = lower_tens
        report[7] = lower_ones

        for attempt in range(3):
            try:
                # Tentativa 1: Feature Report
                res = self.device.send_feature_report(report)
                if res >= 0:
                    return True

                # Tentativa 2 (Fallback): Output Report (write)
                res_write = self.device.write(report)
                if res_write >= 0:
                    return True
            except Exception:
                pass
            time.sleep(0.02)

        print("\nErro ao enviar dados para o display após retentativas (Feature & Output Report)")
        return False

    def send_temperature(self, temp_celsius: float, unit: str = 'c') -> bool:
        """Método de compatibilidade: envia temperatura lendo a potência atual."""
        watts = self.power_reader.get_watts()
        return self.send_display_data(temp_celsius=temp_celsius, watts=watts, unit=unit)

    def blank_display(self) -> bool:
        """Limpa/desliga o display LCD."""
        if not self.device:
            print("Dispositivo não conectado.")
            return False

        try:
            report = [REPORT_ID] + [0] * (REPORT_LENGTH - 1)
            res = self.device.send_feature_report(report)
            return res >= 0
        except Exception as e:
            print(f"Erro ao limpar o display: {e}")
            return False

    def list_devices(self) -> List[Dict[str, Any]]:
        """Lista todos os dispositivos MACH1 encontrados."""
        devices = []
        for pid in PIDS:
            devices.extend(hid.enumerate(VID, pid))
        return devices


def get_temperature_sensors() -> Dict[str, List[Any]]:
    """Obtém todos os sensores de temperatura disponíveis via psutil."""
    try:
        if not hasattr(psutil, "sensors_temperatures"):
            print("Erro: Seu SO não suporta leitura de temperatura via psutil.")
            return {}
        return psutil.sensors_temperatures()
    except Exception as e:
        print(f"Erro ao ler sensores de temperatura: {e}")
        return {}


def find_sensor_by_substring(sensors: Dict[str, List[Any]], 
                            substring: str) -> Optional[Tuple[str, float]]:
    """
    Busca inteligente por sensor de temperatura.
    Se o substring for 'auto' ou não for encontrado diretamente, tenta sensores comuns de CPU (k10temp, coretemp, etc).
    """
    if not sensors:
        return None

    # 1. Tentar busca exata/parcial pelo substring solicitado (se não for "auto")
    if substring and substring.lower() != "auto":
        for sensor_name, sensor_list in sensors.items():
            if substring.lower() in sensor_name.lower() and sensor_list:
                for sensor in sensor_list:
                    if hasattr(sensor, 'current') and sensor.current > 0:
                        return sensor_name, sensor.current

    # 2. Se a busca direta falhou ou o usuário passou "auto", tentar fallbacks conhecidos de CPU
    for candidate in CPU_SENSOR_FALLBACKS:
        for sensor_name, sensor_list in sensors.items():
            if candidate.lower() in sensor_name.lower() and sensor_list:
                for sensor in sensor_list:
                    if hasattr(sensor, 'current') and sensor.current > 0:
                        return sensor_name, sensor.current

    # 3. Fallback genérico: primeiro sensor com leitura maior que zero
    for sensor_name, sensor_list in sensors.items():
        if sensor_list:
            for sensor in sensor_list:
                if hasattr(sensor, 'current') and sensor.current > 0:
                    return sensor_name, sensor.current

    return None


def build_temperature_report(sensor_substring: str = DEFAULT_SENSOR_SUBSTR) -> str:
    """Constrói um relatório detalhado de sensores de temperatura para depuração."""
    sensors = get_temperature_sensors()
    if not sensors:
        return "Nenhum sensor de temperatura encontrado."
    
    selected_sensor_data = find_sensor_by_substring(sensors, sensor_substring)
    selected_name = selected_sensor_data[0] if selected_sensor_data else ""

    report_lines = ["Sensores de temperatura disponíveis:"]
    for sensor_name, sensor_list in sensors.items():
        for sensor in sensor_list:
            temp_str = f"{sensor.current:.1f}°C"
            highlight = " ← SELECIONADO" if sensor_name == selected_name else ""
            report_lines.append(f"  {sensor_name}: {temp_str}{highlight}")
    
    return "\n".join(report_lines)


def run_display_loop(controller: Mach1Controller, 
                    sensor_substring: str, 
                    unit: str, 
                    refresh_rate: float,
                    mode: str = 'power'):
    """Executa o loop principal de atualização no display (Temperatura + Consumo Watts / Rotação Cooler + Nível de Barra)."""
    print(f"Iniciando display de temperatura e {mode.upper()} (Unidade: {unit.upper()}, Modo: {mode.upper()}, Atualização: {refresh_rate}s)")
    print("Pressione Ctrl+C para parar.")
    
    last_keepalive = time.time()
    
    while True:
        try:
            if not controller.device:
                print("\nDispositivo desconectado. Tentando reconectar ao cooler MACH1...")
                if not controller.open():
                    time.sleep(2.0)
                    continue

            sensors = get_temperature_sensors()
            sensor_data = find_sensor_by_substring(sensors, sensor_substring)
            watts = controller.power_reader.get_watts()
            rpm = controller.fan_reader.get_rpm()
            
            if sensor_data:
                sensor_name, temp_celsius = sensor_data
                success = controller.send_display_data(
                    temp_celsius=temp_celsius, 
                    watts=watts, 
                    unit=unit, 
                    mode=mode
                )
                if success:
                    last_keepalive = time.time()
                    display_temp = temp_celsius if unit.lower() == 'c' else temp_celsius * 9/5 + 32
                    unit_symbol = '°C' if unit.lower() == 'c' else '°F'
                    mode_info = f"Power: {watts:.1f}W" if mode.lower() == 'power' else f"Fan: {rpm:.0f} RPM"
                    print(f"\rSensor: {sensor_name} | Temp: {display_temp:.1f}{unit_symbol} | {mode_info}   ", end="", flush=True)
                else:
                    print("\rFalha ao enviar dados para o display. Fechando conexão para tentar reconectar...", end="", flush=True)
                    controller.close()
                    time.sleep(1.0)
            else:
                print(f"\rNenhum sensor de temperatura encontrado", end="", flush=True)
                current_time = time.time()
                if current_time - last_keepalive >= KEEPALIVE_INTERVAL:
                    if controller.send_display_data(temp_celsius=0, watts=0, unit=unit, mode=mode):
                        last_keepalive = current_time
                    else:
                        controller.close()
                        time.sleep(1.0)
            
            time.sleep(refresh_rate)
            
        except KeyboardInterrupt:
            print("\nParando exibição no display.")
            break
        except Exception as e:
            print(f"\nErro no loop de display: {e}")
            controller.close()
            time.sleep(refresh_rate)


def install_udev_rules(rules_path: str = "/etc/udev/rules.d/99-mach1-cooler.rules"):
    """Instala as regras do udev para liberar acesso ao USB e desativar USB autosuspend sem necessidade de sudo."""
    content = """# Regra UDEV para o Cooler MACH1 DIG
# Permissão de acesso sem sudo
SUBSYSTEM=="usb", ATTRS{idVendor}=="1a2c", ATTRS{idProduct}=="4d84", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1a2c", ATTRS{idProduct}=="4c84", MODE="0666"
KERNEL=="hidraw*", ATTRS{idVendor}=="1a2c", MODE="0666"

# Desativação do USB Autosuspend / Selecionado no kernel Linux (evita travamento do display / erro -71)
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="1a2c", ATTR{power/control}="on"
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="1a2c", ATTR{power/autosuspend}="-1"
"""
    try:
        with open(rules_path, 'w') as f:
            f.write(content)
        print(f"Regras UDEV salvas em {rules_path}")
        print("Recarregando regras do udev...")
        os.system("udevadm control --reload-rules && udevadm trigger")
        print("Sucesso! O dispositivo agora pode ser acessado por qualquer usuário e o USB Autosuspend foi desativado.")
    except PermissionError:
        print(f"Erro: Permissão negada. Execute com sudo: sudo python3 {sys.argv[0]} install-udev")
    except Exception as e:
        print(f"Erro ao instalar regras udev: {e}")


def install_systemd_service(unit: str = 'c', 
                          sensor: str = DEFAULT_SENSOR_SUBSTR, 
                          rate: float = DEFAULT_REFRESH_RATE,
                          mode: str = 'power',
                          service_name: str = "mach1-lcd"):
    """Cria e instala uma unidade de serviço do systemd."""
    script_path = os.path.abspath(__file__)
    
    service_content = f"""[Unit]
Description=MACH1 DIG LCD Temperature and Power Display
After=multi-user.target

[Service]
Type=simple
User=root
ExecStart={sys.executable} {script_path} on -u {unit} -s "{sensor}" -r {rate} -m {mode}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
"""
    
    service_file_path = f"/etc/systemd/system/{service_name}.service"
    
    try:
        with open(service_file_path, 'w') as f:
            f.write(service_content)
        
        print(f"Serviço Systemd criado: {service_file_path}")
        print("\nPara habilitar e iniciar o serviço:")
        print(f"  sudo systemctl daemon-reload")
        print(f"  sudo systemctl enable --now {service_name}.service")
        print("\nPara checar o status do serviço:")
        print(f"  systemctl status {service_name}.service")
        
    except PermissionError:
        print(f"Erro: Permissão negada. Execute com sudo para instalar o serviço.")
    except Exception as e:
        print(f"Erro ao criar arquivo de serviço: {e}")


def main():
    """Função principal."""
    parser = argparse.ArgumentParser(
        description="Driver para o display LCD de cooler MACH1 DIG (Linux)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""
        Exemplos de Uso:
          %(prog)s list                    # Lista dispositivos MACH1 encontrados
          %(prog)s on                      # Inicia exibição de temperatura e consumo em Watts
          %(prog)s on -u f                 # Inicia exibição de temperatura em Fahrenheit
          %(prog)s on -m fan               # Exibe a velocidade do cooler (RPM) na linha inferior
          %(prog)s on -s "k10temp"         # Usa um sensor específico (ex: AMD k10temp, Intel coretemp)
          %(prog)s off                     # Desliga (limpa) o display
          %(prog)s install-udev            # Instala regra udev para usar sem sudo
          %(prog)s install-service         # Instala serviço systemd
        """)
    )
    
    subparsers = parser.add_subparsers(dest='command', help='Comandos disponíveis')
    
    # Comando List
    subparsers.add_parser('list', help='Lista todos os coolers MACH1 encontrados')
    
    # Comando On
    on_parser = subparsers.add_parser('on', help='Liga o display e transmite temperatura e consumo (Watts/RPM)')
    on_parser.add_argument('-u', '--unit', choices=['c', 'f'], default='c',
                          help='Unidade: c=Celsius, f=Fahrenheit (padrão: c)')
    on_parser.add_argument('-m', '--mode', choices=['power', 'fan'], default='power',
                          help='Modo inferior: power=Watts, fan=Speed RPM (padrão: power)')
    on_parser.add_argument('-s', '--sensor', default=DEFAULT_SENSOR_SUBSTR,
                          help='Nome/Substring do sensor ou "auto" para detecção automática (padrão: auto)')
    on_parser.add_argument('-r', '--rate', type=float, default=DEFAULT_REFRESH_RATE,
                          help=f'Intervalo de atualização em segundos (padrão: {DEFAULT_REFRESH_RATE})')
    
    # Comando Off
    subparsers.add_parser('off', help='Desliga o display LCD')
    
    # Comando Install Udev
    subparsers.add_parser('install-udev', help='Instala regras udev para permitir uso sem sudo')

    # Comando Install Service
    service_parser = subparsers.add_parser('install-service', 
                                          help='Instala unidade systemd para execução em segundo plano')
    service_parser.add_argument('-u', '--unit', choices=['c', 'f'], default='c',
                               help='Unidade de temperatura para o serviço (padrão: c)')
    service_parser.add_argument('-m', '--mode', choices=['power', 'fan'], default='power',
                               help='Modo de exibição inferior: power=Watts, fan=RPM (padrão: power)')
    service_parser.add_argument('-s', '--sensor', default=DEFAULT_SENSOR_SUBSTR,
                               help='Sensor para o serviço (padrão: auto)')
    service_parser.add_argument('-r', '--rate', type=float, default=DEFAULT_REFRESH_RATE,
                               help=f'Intervalo de atualização para o serviço (padrão: {DEFAULT_REFRESH_RATE})')
    service_parser.add_argument('--name', default='mach1-lcd',
                               help='Nome para a unidade systemd (padrão: mach1-lcd)')
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return
    
    def signal_handler(signum: int, frame: Optional[FrameType]):
        print("\nSinal de interrupção recebido. Encerrando graciosamente...")
        sys.exit(0)
    
    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)
    
    if args.command == 'list':
        controller = Mach1Controller()
        devices = controller.list_devices()
        if devices:
            print(f"Encontrados {len(devices)} dispositivo(s) MACH1 DIG:")
            for i, device in enumerate(devices, 1):
                interface = device.get('interface_number', 'Unknown')
                path = device.get('path', b'Unknown')
                print(f"  {i}. Interface {interface} (Path: {path.decode() if isinstance(path, bytes) else path})")
        else:
            print("Nenhum dispositivo MACH1 DIG encontrado.")
    
    elif args.command == 'on':
        with Mach1Controller() as controller:
            if controller.device:
                print(build_temperature_report(args.sensor))
                run_display_loop(controller, args.sensor, args.unit, args.rate, args.mode)
    
    elif args.command == 'off':
        with Mach1Controller() as controller:
            if controller.device:
                success = controller.blank_display()
                if success:
                    print("Display desligado.")
                else:
                    print("Falha ao desligar o display.")

    elif args.command == 'install-udev':
        install_udev_rules()
    
    elif args.command == 'install-service':
        install_systemd_service(args.unit, args.sensor, args.rate, args.name)


if __name__ == "__main__":
    main()
